# YOLO model path. The project stores yolo11n.pt in models/.
YOLO_MODEL=models/yolo11n.pt
YOLO_CONF=0.35
PORT=8000

# Optional free-tier, OpenAI-compatible model API.
# Example: SiliconFlow free models, or any compatible chat/completions endpoint.
FREE_LLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
FREE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
FREE_LLM_API_KEY=
